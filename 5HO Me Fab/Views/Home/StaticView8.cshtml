@{
    Layout = ViewBag.PrintMode == true ? null : "_Layout";
}
@if (ViewBag.PrintMode == true)
{
    <style>
        .sheet {
            padding: 20px;
            font-family: Arial;
        }

        .section {
            margin-bottom: 20px;
        }

        .section-title {
            font-weight: bold;
        }

        .schedule-table {
            width: 100%;
            border-collapse: collapse;
        }

            .schedule-table th, .schedule-table td {
                border: 1px solid #000;
                padding: 5px;
            }
    </style>
}

<div class="contract-page">

    <div class="contract-section">
        <span class="contract-section-number">19.</span>
        <span class="contract-section-title">Applicable Law:</span>
        <p class="contract-section-body">
            This Sales Order shall be governed by the laws of the State of Missouri without regard to any conflict
            of law’s provisions. Any legal suit, action, or proceeding arising out of or relating to this Sales
            Order shall be brought exclusively in the state or federal courts located in Greene County, Missouri.
        </p>
    </div>

    <div class="contract-section">
        <span class="contract-section-number">20.</span>
        <span class="contract-section-title">Relationship of the Parties:</span>
        <p class="contract-section-body">
            The relationship between the parties is that of independent contractors. Nothing contained in this
            Sales Order shall be construed as creating any agency, partnership, joint venture or other form of
            joint enterprise, employment or fiduciary relationship between the parties, and neither party shall
            have authority to contract for or bind the other party in any manner whatsoever.
        </p>
    </div>

    <div class="contract-section">
        <span class="contract-section-number">21.</span>
        <span class="contract-section-title">Governing Terms:</span>
        <p class="contract-section-body">
            The terms and conditions in this Sales Order shall govern the agreement between the parties. Acceptance
            of this Sales Order is hereby limited to the terms in this Sales Order. No other terms, whether
            additional or different, shall be a part of the agreement between the parties and are hereby rejected.
            This Sales Order constitutes the complete and final expression of the agreement of the parties relating
            to this Sales Order and supersedes all previous contracts, agreements, and understandings of the
            parties, either oral or written. This Sales Order shall only be amended by a written agreement signed
            by both parties.
        </p>
    </div>

    <div class="contract-section">
        <span class="contract-section-number">22.</span>
        <span class="contract-section-title">Miscellaneous:</span>
        <p class="contract-section-body">
            This Sales Order is intended by the parties as a complete and exclusive statement of the terms of their
            agreement and supersedes all prior or contemporaneous understandings, agreements, communications, and
            representations, whether written or oral. No claim or right arising out of a breach of this Sales Order
            can be discharged in whole or in part by a waiver or renunciation unless in a writing signed by Seller.
            Purchaser shall not assign its rights or delegate its duties under this Sales Order. This Sales Order is
            solely for the benefit of the parties hereto and their respective successors and permitted assigns and
            nothing herein, express or implied, shall confer upon any other person or entity any legal or equitable
            right, benefit or remedy of any nature whatsoever. If any term or provision is invalid, illegal, or
            unenforceable, such invalidity shall not affect any other term of this Sales Order.
        </p>
    </div>

    <div class="contract-section">
        <span class="contract-section-number">23.</span>
        <span class="contract-section-title">Attorney’s Fees:</span>
        <p class="contract-section-body">
            In the event of any claim or action arising out of or relating to this Sales Order, Seller shall be
            entitled to recover its attorney’s fees from Purchaser if Seller is the prevailing party.
        </p>
    </div>

    <div class="contract-section">
        <span class="contract-section-number">24.</span>
        <span class="contract-section-title">Notices:</span>
        <p class="contract-section-body">
            All notices, requests, consents, claims, demands, waivers and other communications hereunder (“Notices”)
            shall be in writing and addressed to the parties at the addresses set forth on the face of the Sales
            Order or to such other address designated in writing. Notices are effective on the date sent if delivered
            personally or by overnight courier, or on the third day after deposit with the carrier if sent by
            certified or registered mail.
        </p>
    </div>

    <div class="contract-section">
        <span class="contract-section-number">25.</span>
        <span class="contract-section-title">Indemnification:</span>
        <p class="contract-section-body">
            To the fullest extent permitted by law, Purchaser shall indemnify and hold harmless Seller and its
            officers, directors, members, consultants, agents, subcontractors, or anyone employed directly or
            indirectly by them (collectively, the “Seller Indemnitees”) from all claims (including reasonable
            attorneys’ fees, costs, and expenses) for bodily injury and property damage arising from improper use of
            the Goods, Purchaser’s breach of this Sales Order, or intellectual property infringement claims related
            to designs or specifications provided by Purchaser.
        </p>
    </div>

    <div class="contract-section">
        <span class="contract-section-title">Work Performed at Purchaser’s Location</span>
    </div>
</div>

