@model _5HO_Me_Fab.Models.UserInputModel
<link rel="stylesheet" href="~/css/site.css" />

<div class="text-center">
    <h1 class="display-4">5HO Me Fab Tank Customization</h1>
</div>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <form method="post">

                <div class="form-group mb-3">
                    <label>Name:</label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Tank Customization 1:</label>
                    <input asp-for="TankCust1" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Tank Customization 2:</label>
                    <input asp-for="TankCust2" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Tank Customization 3:</label>
                    <input asp-for="TankCust3" class="form-control" />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>

            </form>

        </div>
    </div>
</div>