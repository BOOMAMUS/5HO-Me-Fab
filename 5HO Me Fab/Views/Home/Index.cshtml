@model _5HO_Me_Fab.Models.UserInputModel
@using Microsoft.AspNetCore.Mvc.Rendering
<link rel="stylesheet" href="~/css/site.css" />

<div class="text-center">
    <h1 class="display-4">5HO Me Fab Tank Customization</h1>
</div>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <form method="post">
                <div class="form-group mb-3">
                    <label>Tank Customization 1:</label>
                    <select asp-for="TankCust1" asp-items="@(new SelectList(Model.TankOptions))" class="form-control"></select>
                </div>

                <div class="form-group mb-3">
                    <label>Tank Customization 2:</label>
                    <select asp-for="TankCust2" asp-items="@(new SelectList(Model.TankOptions))" class="form-control"></select>
                </div>

                <div class="form-group mb-3">
                    <label>Tank Customization 3:</label>
                    <select asp-for="TankCust3" asp-items="@(new SelectList(Model.TankOptions))" class="form-control"></select>
                </div>

                <div class="text-center mt-3">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>
            </form>

        </div>
    </div>
</div>