@model _5HO_Me_Fab.Models.UserInputModel

<div class="text-center">
    <h1 class="display-4">User Information Form</h1>
    <p>Please enter your details below.</p>
</div>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <form method="post">

                <div class="form-group mb-3">
                    <label>Name:</label>
                    <input asp-for="Name" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Age:</label>
                    <input asp-for="Age" type="number" class="form-control" />
                </div>

                <div class="form-group mb-3">
                    <label>Favorite Color:</label>
                    <input asp-for="FavoriteColor" class="form-control" />
                </div>
                
                <div class="form-group mb-3">
                    <label>Hobby:</label>
                    <input asp-for="Hobby" class="form-control" />
                </div>

                <div class="text-center">
                    <button type="submit" class="btn btn-primary">Submit</button>
                </div>

            </form>

        </div>
    </div>
</div>
