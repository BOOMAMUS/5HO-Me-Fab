@model _5HO_Me_Fab.Models.UserInputModel
@using Microsoft.AspNetCore.Mvc.Rendering

<form asp-action="Index" method="post">
    <div class="row">

        <div class="col-md-6 left-col">

            <h4 class="mb-3">Tank Customizations</h4>

            <div class="mb-3">
                <label class="form-label">Tank Customization 1</label>
                <select id="TankCust1" asp-for="TankCust1" class="form-select" asp-items="@(new SelectList(Model.TankOptions))">
                    <option value="">Select Option</option>
                </select>
                <textarea id="TankCust1Notes" asp-for="TankCust1Notes" class="form-control notes-box" placeholder="Notes for customization 1"></textarea>
                <p id="desc1" class="desc-output"></p>
            </div>

            <div class="mb-3">
                <label class="form-label">Tank Customization 2</label>
                <select id="TankCust2" asp-for="TankCust2" class="form-select" asp-items="@(new SelectList(Model.TankOptions))">
                    <option value="">Select Option</option>
                </select>
                <textarea id="TankCust2Notes" asp-for="TankCust2Notes" class="form-control notes-box" placeholder="Notes for customization 2"></textarea>
                <p id="desc2" class="desc-output"></p>
            </div>

            <div class="mb-3">
                <label class="form-label">Tank Customization 3</label>
                <select id="TankCust3" asp-for="TankCust3" class="form-select" asp-items="@(new SelectList(Model.TankOptions))">
                    <option value="">Select Option</option>
                </select>
                <textarea id="TankCust3Notes" asp-for="TankCust3Notes" class="form-control notes-box" placeholder="Notes for customization 3"></textarea>
                <p id="desc3" class="desc-output"></p>
            </div>

            <div class="mb-3">
                <label class="form-label">Tank Customization 4</label>
                <select id="TankCust4" asp-for="TankCust4" class="form-select" asp-items="@(new SelectList(Model.TankOptions))">
                    <option>Select Option</option>
                </select>
                <textarea id="TankCust4Notes" asp-for="TankCust4Notes" class="form-control notes-box" placeholder="Notes for customization 4"></textarea>
                <p id="desc4" class="desc-output"></p>
            </div>

            <div class="mb-3">
                <label class="form-label">Tank Customization 5</label>
                <select id="TankCust5" asp-for="TankCust5" class="form-select" asp-items="@(new SelectList(Model.TankOptions))">
                    <option>Select Option</option>
                </select>
                <textarea id="TankCust5Notes" asp-for="TankCust5Notes" class="form-control notes-box" placeholder="Notes for customization 5"></textarea>
                <p id="desc5" class="desc-output"></p>
            </div>

            <div class="mb-3">
                <label class="form-label">Tank Customization 6</label>
                <select id="TankCust6" asp-for="TankCust6" class="form-select" asp-items="@(new SelectList(Model.TankOptions))">
                    <option>Select Option</option>
                </select>
                <textarea id="TankCust6Notes" asp-for="TankCust6Notes" class="form-control notes-box" placeholder="Notes for customization 6"></textarea>
                <p id="desc6" class="desc-output"></p>
            </div>

        </div>

        <div class="col-md-6 right-col">

            <div class="border bg-light p-3 mb-4" style="height: 300px;">
                <img src="~/images/Tank.png" style="max-width:100%; max-height:100%; object-fit:contain;" />
            </div>

            <h4 class="mb-3">Pricing</h4>

            <div class="mb-3">
                <label class="form-label">Tank Base Price</label>
                <div id="price-base" class="math-line">$31,085.00</div>
            </div>

            <div class="mb-3">
                <label class="form-label">Individual Parts Pricing</label>
                <div id="price-individual-breakdown" class="math-line"></div>
                <div id="price-individual" class="math-line"></div>
            </div>

            <div class="mb-3">
                <label class="form-label">Labor Hours</label>
                <div id="price-labor-breakdown" class="math-line"></div>
                <div id="price-labor" class="math-line"></div>
            </div>

            <hr style="border-top: 2px solid black; width: 60%; margin: 10px 0;">

            <div class="mb-3">
                <label class="form-label">Tax</label>
                <div id="price-tax-breakdown" class="math-line"></div>
                <div id="price-tax" class="math-line"></div>
            </div>

            <div class="mb-3">
                <label class="form-label">Total</label>
                <div id="price-total" class="math-line"></div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end mt-4">
        <button type="submit" formaction="/Home/ExportToExcel" formmethod="post" class="btn export-btn px-4">Export to Excel</button>
    </div>
</form>

<a href="/Home/NextPage/1" class="next-arrow">&#10140;</a>

@section Scripts {
    <script>
        window.tankLookupData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TankLookup));
        window.tankPriceData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TankPrices));
    </script>
    <script src="~/js/site.js?v=3"></script>
}