@{
    Layout = Context.Request.Query["print"] == "1" ? null : "_Layout";
}
@if (Context.Request.Query["print"] == "1")
{
    <style>
        .sheet {
            padding: 20px;
            font-family: Arial;
        }

        .section {
            margin-bottom: 20px;
        }

        .section-title {
            font-weight: bold;
        }

        .schedule-table {
            width: 100%;
            border-collapse: collapse;
        }

            .schedule-table th, .schedule-table td {
                border: 1px solid #000;
                padding: 5px;
            }
    </style>
}

<div class="sheet">
    <h1>Tank Specification Sheet</h1>

    <div class="section">
        <div class="section-title">Product contact weld finish:</div>
        <div class="section-content">
            Welds smooth &amp; flush tape line #4 32 RA
        </div>
    </div>

    <div class="section">
        <div class="section-title">Non-product contact material type and finish:</div>
        <div class="section-content">
            304/304L stainless. #4 32 RA
        </div>
    </div>

    <div class="section">
        <div class="section-title">Non-product contact weld finish:</div>
        <div class="section-content">
            Welds tape line buff. Some weld ripple may be present. Clean and free of color and debris.
        </div>
    </div>

    <div class="section">
        <div class="section-title">Top head type, diameter and thickness:</div>
        <div class="section-content">
            Open top
        </div>
    </div>

    <div class="section">
        <div class="section-title">Bottom head type, diameter and thickness:</div>
        <div class="section-content">
            3/8" (X) 54" OD flat bottom head
        </div>
    </div>

    <div class="section">
        <div class="section-title">Shell diameter, length and thickness:</div>
        <div class="section-content">
            1/4" (X) 54-1/16" ID (X) 60" S.W.H
        </div>
    </div>

    <div class="section">
