@{
    Layout = ViewBag.PrintMode == true ? null : "_Layout";
}
@if (ViewBag.PrintMode == true)
{
    <style>
        .sheet {
            padding: 20px;
            font-family: Arial;
        }

        .section {
            margin-bottom: 20px;
        }

        .section-title {
            font-weight: bold;
        }

        .schedule-table {
            width: 100%;
            border-collapse: collapse;
        }

            .schedule-table th, .schedule-table td {
                border: 1px solid #000;
                padding: 5px;
            }
    </style>
}

<div class="spec-section">
    <div class="spec-title">Schedule:</div>
    <div class="spec-content">
        <div>
            • (2) weeks for preliminary drawings with authorization to purchase long lead‑time components.
            This requires customer approval of general dimensions and long‑lead components.
        </div>

        <div style="margin-top: 8px;">
            • (2) weeks for final drawing approvals and supporting calculations.
            Includes up to (2) major revisions.
            Additional major revisions billed at $4,500.00 each.
        </div>

        <div style="margin-top: 8px;">
            • Shipping approximately (14) weeks after drawings are approved for fabrication.
        </div>
    </div>
</div>

<div class="spec-section">
    <div class="spec-title">Payment Terms:</div>
    <div class="spec-content">
        <div>• 30% with purchase order, net 10 days</div>
        <div>• 50% upon customer approval to purchase major materials, net 30 days</div>
        <div>• 10% completion / prior to shipment, net 10 days</div>
        <div>• 10% + freight at shipment, net 30 days</div>
    </div>
</div>

<div class="spec-section">
    <div class="spec-title">Quote Validation:</div>
    <div class="spec-content">
        Based on market conditions, global inflation, and material cost/availability fluctuations,
        Sho‑Me Fabrication, LLC can honor quotes for (15) calendar days.
    </div>
</div>

<div class="spec-section">
    <div class="spec-title">Exclusions:</div>
    <div class="spec-content">
        <div>• On‑site installation including equipment, material, rigging, manpower, leveling, anchoring, grouting, etc.</div>
        <div>• On‑site installation and assembly of any components or instruments shipped loose</div>
        <div>• All civil engineering duties and responsibilities OF.</div>
    </div>
</div>

