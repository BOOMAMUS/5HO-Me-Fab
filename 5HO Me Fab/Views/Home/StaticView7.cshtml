@{
    Layout = Context.Request.Query["print"] == "1" ? null : "_Layout";
}
@if (Context.Request.Query["print"] == "1")
{
    <style>
        .sheet {
            padding: 20px;
            font-family: Arial;
        }

        .section {
            margin-bottom: 20px;
        }

        .section-title {
            font-weight: bold;
        }

        .schedule-table {
            width: 100%;
            border-collapse: collapse;
        }

            .schedule-table th, .schedule-table td {
                border: 1px solid #000;
                padding: 5px;
            }
    </style>
}

<div class="contract-page">
    <div class="contract-section">
        <span class="contract-section-number">15.</span>
        <span class="contract-section-title">Warranty Claims:</span>
        <p class="contract-section-body">
            The Seller shall not be liable for a breach of the warranty set forth herein unless:
            (i) Purchaser gives written notice of the defect, reasonably described, to Seller within five (5) days
            of the time when Purchaser discovers or ought to have discovered the defect;
            (ii) Seller is given a reasonable opportunity after receiving the notice to examine such Goods and
            Purchaser (if requested to do so by Seller) returns such Goods to Seller’s place of business at
            Purchaser’s cost for the examination to take place there; and
            (iii) Seller reasonably verifies Purchaser’s claim that the Goods are defective.
            The Seller shall not be liable for a breach of the warranty set forth in Section 13 if:
            (i) Purchaser makes any further use of such Goods after giving such notice;
            (ii) the defect arises because Purchaser failed to follow Seller’s oral or written instructions as to the
            storage, installation, use or maintenance of the Goods; or
            (iii) Purchaser alters or repairs such Goods without the prior written consent of Seller.
            Subject to the limitations herein, if Goods are defective and covered by this warranty, Seller shall,
            in its sole discretion, either (i) repair or replace such Goods (or the defective part) or
            (ii) credit or refund the price of such Goods. If, in Seller’s sole discretion, Seller determines that the
            Purchaser cannot return the defective product, Seller may elect either (i) to repair the Goods at
            Purchaser’s facility, using independent contractors or Seller’s own personnel, or (ii) to pay Purchaser
            a reasonable charge for repairs, not exceeding the amount which Seller would have paid for such repairs.
        </p>
    </div>

    <div class="contract-section">
        <span class="contract-section-number">16.</span>
        <span class="contract-section-title">Limitation of Liability:</span>
        <p class="contract-section-body">
            [Insert the limitation of liability clause text here, following the same formatting and justification
            as the other sections on this page.]
        </p>
    </div>

    <div class="contract-section">
        <span class="contract-section-number">17.</span>
        <span class="contract-section-title">Cancellation:</span>
        <p class="contract-section-body">
            [Insert the cancellation clause text here, formatted consistently with the other numbered sections
            and aligned in a justified paragraph.]
        </p>
    </div>

    <div class="contract-section">
        <span class="contract-section-number">18.</span>
        <span class="contract-section-title">Remedies:</span>
        <p class="contract-section-body">
            [Insert the remedies clause text here, maintaining the same layout, spacing, and typography as the
            preceding sections on this page.]
        </p>
    </div>
</div>

